<div class="max-w-[1200px] mx-auto w-full px-4 md:px-12 py-12">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 border-b border-outline-variant/30 mb-8 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-secondary block mb-1">VIP Member Account</span>
      <h1 class="font-headline-lg text-3xl font-bold text-primary">Bonjour, {{ customer.first_name }}</h1>
    </div>
    <a href="{{ routes.account_logout_url }}" class="text-xs font-bold text-secondary hover:text-primary underline">
      Sign Out
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Order History -->
    <div class="lg:col-span-8 bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 shadow-xs">
      <h3 class="font-bold text-base text-primary uppercase tracking-wider mb-4">Order History</h3>
      {% paginate customer.orders by 10 %}
        {% if customer.orders.size > 0 %}
          <div class="divide-y divide-outline-variant/20 text-xs">
            {% for order in customer.orders %}
              <div class="py-3 flex items-center justify-between">
                <div>
                  <span class="font-bold text-primary">{{ order.name }}</span>
                  <span class="text-on-surface-variant ml-2">{{ order.created_at | date: '%b %d, %Y' }}</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class="font-bold text-secondary">{{ order.total_price | money }}</span>
                  <a href="{{ order.customer_url }}" class="text-secondary font-bold hover:underline">View</a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-xs text-on-surface-variant py-4">You haven't placed any orders yet. Discover our latest seasonal drops.</p>
        {% endif %}
      {% endpaginate %}
    </div>

    <!-- Account Details -->
    <div class="lg:col-span-4 bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 shadow-xs">
      <h3 class="font-bold text-base text-primary uppercase tracking-wider mb-4">Account Details</h3>
      <p class="text-xs font-semibold text-primary">{{ customer.name }}</p>
      <p class="text-xs text-on-surface-variant">{{ customer.email }}</p>
      {% if customer.default_address %}
        <div class="mt-4 pt-4 border-t border-outline-variant/20 text-xs text-on-surface-variant">
          <p class="font-bold text-primary mb-1">Default Address:</p>
          <p>{{ customer.default_address.address1 }}</p>
          <p>{{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}</p>
          <p>{{ customer.default_address.country }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>
