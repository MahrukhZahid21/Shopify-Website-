<div class="max-w-[480px] mx-auto w-full px-4 py-16">
  <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-md">
    <div class="text-center mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-secondary block mb-1">VIP Portal</span>
      <h1 class="font-headline-lg text-3xl font-bold text-primary">Member Sign In</h1>
      <p class="text-xs text-on-surface-variant mt-1">Access your wardrobe wishlist and order tracking</p>
    </div>

    {% form 'customer_login', class: 'space-y-4' %}
      {{ form.errors | default_errors }}

      <div>
        <label class="block text-xs font-bold text-primary uppercase mb-1" for="CustomerEmail">Email</label>
        <input type="email" name="customer[email]" id="CustomerEmail" required class="w-full h-11 px-4 rounded-xl bg-surface-container-low border border-outline-variant/40 text-xs text-primary focus:outline-none focus:border-secondary">
      </div>

      {% if form.password_needed %}
        <div>
          <label class="block text-xs font-bold text-primary uppercase mb-1" for="CustomerPassword">Password</label>
          <input type="password" name="customer[password]" id="CustomerPassword" required class="w-full h-11 px-4 rounded-xl bg-surface-container-low border border-outline-variant/40 text-xs text-primary focus:outline-none focus:border-secondary">
        </div>
      {% endif %}

      <button type="submit" class="w-full py-3.5 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all mt-2">
        Sign In
      </button>

      <div class="text-center pt-4 border-t border-outline-variant/20 text-xs text-on-surface-variant">
        <span>Don't have an account? </span>
        <a href="{{ routes.account_register_url }}" class="text-secondary font-bold hover:underline">Create Account</a>
      </div>
    {% endform %}
  </div>
</div>
