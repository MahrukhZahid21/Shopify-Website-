        "default": "#300033"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Brand Color (Hot Pink)",
        "default": "#B40063"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Pastel Lavender Accent",
        "default": "#D8B4F8"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page Background",
        "default": "#FCF8FF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body Text Color",
        "default": "#1A1A2B"
      }
    ]
  },
  {
    "name": "Announcement Bar & Shipping",
    "settings": [
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (Amount in $)",
        "default": "50"
      },
      {
        "type": "text",
        "id": "promo_code",
        "label": "Default Promo Code",
        "default": "CHRONICAPP"
      },
      {
        "type": "text",
        "id": "promo_discount",
        "label": "Default Promo Discount (%)",
        "default": "10"
      },
      {
        "type": "text",
        "id": "support_phone",
        "label": "Customer Support Phone",
        "default": "+1 800 567 8900"
      }
    ]
  },
  {
    "name": "Cart Drawer",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "drawer", "label": "Slide-Out AJAX Drawer" },
          { "value": "page", "label": "Dedicated Cart Page" }
