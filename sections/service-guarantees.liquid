        <span class="material-symbols-outlined text-[24px]">local_shipping</span>
      </div>
      <div>
        <h4 class="font-bold text-sm text-primary">Free Worldwide Shipping</h4>
        <p class="text-xs text-on-surface-variant mt-0.5">Complimentary on all orders over $50</p>
      </div>
