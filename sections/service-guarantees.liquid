        <span class="material-symbols-outlined text-[24px]">support_agent</span>
      </div>
      <div>
        <h4 class="font-bold text-sm text-primary">24/7 Concierge Support</h4>
        <p class="text-xs text-on-surface-variant mt-0.5">Live expert styling assistance</p>
