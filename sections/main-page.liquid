{%- if page.handle == 'about' or page.handle == 'about-us' -%}
  {% render 'about-content' %}
{%- elsif page.handle == 'faq' or page.handle == 'faqs' -%}
  {% render 'faq-content' %}
{%- elsif page.handle == 'reviews' -%}
  {% render 'reviews-content' %}
{%- else -%}
  <div class="max-w-[1000px] mx-auto w-full px-4 md:px-12 py-12">
    <h1 class="font-headline-lg text-3xl md:text-5xl font-bold text-primary mb-6 text-center">
      {{ page.title }}
    </h1>
    <div class="prose prose-purple max-w-none text-on-surface-variant text-sm md:text-base leading-relaxed bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-xs">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
