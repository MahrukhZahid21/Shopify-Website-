{%- assign current_url = request.path | downcase -%}

{%- if current_url contains 'about' -%}
  <div class="max-w-[1360px] mx-auto px-4 md:px-12 pt-6">
    <div class="p-3 bg-purple-50 border border-purple-200 rounded-2xl text-xs text-primary flex items-center gap-2 shadow-xs">
      <span class="material-symbols-outlined text-secondary text-[20px]">info</span>
      <span><strong>Live Preview:</strong> Chronics About Us editorial. To link this permanently in Shopify Admin, create a Page titled "About Us" under <strong>Online Store &rarr; Pages</strong>.</span>
    </div>
  </div>
  {% render 'about-content' %}

{%- elsif current_url contains 'faq' -%}
  <div class="max-w-[1360px] mx-auto px-4 md:px-12 pt-6">
    <div class="p-3 bg-purple-50 border border-purple-200 rounded-2xl text-xs text-primary flex items-center gap-2 shadow-xs">
      <span class="material-symbols-outlined text-secondary text-[20px]">info</span>
      <span><strong>Live Preview:</strong> Chronics FAQ &amp; Help center. To link this permanently in Shopify Admin, create a Page titled "FAQ" under <strong>Online Store &rarr; Pages</strong>.</span>
    </div>
  </div>
  {% render 'faq-content' %}

{%- elsif current_url contains 'reviews' -%}
  <div class="max-w-[1360px] mx-auto px-4 md:px-12 pt-6">
    <div class="p-3 bg-purple-50 border border-purple-200 rounded-2xl text-xs text-primary flex items-center gap-2 shadow-xs">
      <span class="material-symbols-outlined text-secondary text-[20px]">info</span>
      <span><strong>Live Preview:</strong> Chronics Customer Reviews. To link this permanently in Shopify Admin, create a Page titled "Reviews" under <strong>Online Store &rarr; Pages</strong>.</span>
    </div>
  </div>
  {% render 'reviews-content' %}

{%- else -%}
  <div class="max-w-[600px] mx-auto w-full px-4 py-24 text-center">
    <span class="material-symbols-outlined text-7xl text-secondary mb-4">explore_off</span>
    <h1 class="font-headline-lg text-4xl md:text-5xl font-bold text-primary mb-3">404 — Page Not Found</h1>
    <p class="text-sm text-on-surface-variant mb-8 leading-relaxed">
      The garment, collection, or editorial you were searching for may have transitioned into our archives.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="{{ routes.root_url }}" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all">
        <span class="material-symbols-outlined text-[18px]">home</span>
        <span>Return to Home</span>
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-primary hover:bg-primary-container text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all">
        <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
        <span>Shop All Collections</span>
      </a>
    </div>
  </div>

  <script>
    (function() {
      var p = window.location.pathname.toLowerCase();
      if (p.includes('/shop')) {
        window.location.replace('{{ routes.all_products_collection_url }}');
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
