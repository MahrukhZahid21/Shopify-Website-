<footer class="bg-primary text-white pt-16 pb-8 border-t border-lavender/30">
  <div class="max-w-[1360px] mx-auto px-4 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Bio -->
      <div class="lg:col-span-2 flex flex-col gap-4 pr-0 lg:pr-8">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-secondary to-primary-container flex items-center justify-center text-white shadow-md">
            <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
          </div>
          <span class="font-headline-md text-2xl font-bold tracking-tight">{{ shop.name | default: 'CHRONICS' }}</span>
        </div>
        <p class="text-xs text-white/70 leading-relaxed max-w-sm">
          Chronics is a luxury contemporary fashion house championing effortless individuality, modern silhouettes, and sustainable organic textiles.
        </p>
        <div class="flex items-center gap-3 mt-2">
          <a href="{{ settings.social_instagram_link | default: '#' }}" class="w-9 h-9 rounded-full bg-white/10 hover:bg-secondary flex items-center justify-center transition-colors text-white" aria-label="Instagram">
            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
          </a>
          <a href="{{ settings.social_tiktok_link | default: '#' }}" class="w-9 h-9 rounded-full bg-white/10 hover:bg-secondary flex items-center justify-center transition-colors text-white" aria-label="TikTok">
            <span class="material-symbols-outlined text-[18px]">play_circle</span>
          </a>
          <a href="{{ settings.social_pinterest_link | default: '#' }}" class="w-9 h-9 rounded-full bg-white/10 hover:bg-secondary flex items-center justify-center transition-colors text-white" aria-label="Pinterest">
            <span class="material-symbols-outlined text-[18px]">push_pin</span>
          </a>
        </div>
      </div>

      <!-- Quick Collections -->
      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-secondary-fixed mb-4">Collections</h4>
        <ul class="space-y-2.5 text-xs text-white/70">
          <li><a href="{{ routes.all_products_collection_url }}?cat=dresses" class="hover:text-white transition-colors">Dresses &amp; Skirts</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?cat=tops" class="hover:text-white transition-colors">Tops &amp; Tees</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?cat=denim" class="hover:text-white transition-colors">Denim &amp; Jackets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?cat=shoes" class="hover:text-white transition-colors">Shoes &amp; Footwear</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?cat=sunglasses" class="hover:text-white transition-colors">Sunglasses</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?cat=accessories" class="hover:text-white transition-colors">Fine Jewelry</a></li>
        </ul>
      </div>

      <!-- Concierge & Care -->
      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-secondary-fixed mb-4">Customer Care</h4>
        <ul class="space-y-2.5 text-xs text-white/70">
          <li><a href="/pages/faq" class="hover:text-white transition-colors">Order Tracking &amp; FAQs</a></li>
          <li><a href="/pages/about" class="hover:text-white transition-colors">Our Craft &amp; Story</a></li>
          <li><a href="/pages/reviews" class="hover:text-white transition-colors">Verified Customer Reviews</a></li>
          <li><a href="/pages/contact" class="hover:text-white transition-colors">Contact Concierge</a></li>
          <li><a href="/policies/refund-policy" class="hover:text-white transition-colors">Returns &amp; Exchanges</a></li>
          <li><a href="/policies/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- VIP Club Newsletter -->
      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-secondary-fixed mb-4">Join The VIP Club</h4>
        <p class="text-xs text-white/70 mb-3">Subscribe for 15% off your next runway drop.</p>
        
        {% form 'customer', class: 'flex flex-col gap-2' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Enter your email..." required class="h-10 px-3 rounded-full bg-white/10 border border-white/20 text-xs text-white placeholder-white/40 focus:outline-none focus:border-secondary">
          <button type="submit" class="h-10 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs transition-colors flex items-center justify-center gap-1 shadow-md">
            <span>Subscribe Now</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </button>
        {% endform %}
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-white/50 gap-4">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Chronics' }}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>100% Secure SSL Checkout</span>
        <span>•</span>
        <span>Visa, Mastercard, Amex, Apple Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
