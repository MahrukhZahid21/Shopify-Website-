{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="max-w-[1360px] mx-auto w-full px-4 md:px-12 py-10">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-8">
    <a href="{{ routes.root_url }}" class="hover:text-secondary transition-colors">Home</a>
    <span class="text-gray-400">/</span>
    <a href="{{ routes.all_products_collection_url }}" class="hover:text-secondary transition-colors">Collections</a>
    <span class="text-gray-400">/</span>
    <span class="text-secondary font-bold">{{ product.title }}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- LEFT: Image Gallery (Stage + Thumbnails) -->
    <div class="lg:col-span-7 flex flex-col gap-4">
      <div class="relative w-full aspect-[4/5] rounded-3xl bg-surface-container-low overflow-hidden border border-lavender shadow-md flex items-center justify-center p-6">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-secondary text-white text-xs font-bold shadow-md">
            SALE
          </span>
        {%- endif -%}
        
        <img id="main-stage-img" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" class="w-full h-full object-contain transition-opacity duration-300">
      </div>

      <!-- Thumbnail Carousel -->
      {%- if product.images.size > 1 -%}
        <div class="grid grid-cols-4 gap-3">
          {%- for image in product.images limit: 4 -%}
            <button onclick="document.getElementById('main-stage-img').src = '{{ image | image_url: width: 1000 }}'" class="aspect-[4/5] rounded-xl overflow-hidden border border-outline-variant/40 bg-surface-container-low hover:border-secondary p-1 transition-all">
              <img src="{{ image | image_url: width: 300 }}" alt="{{ product.title | escape }}" class="w-full h-full object-contain">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT: Product Purchase Information -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-purple-100 text-primary text-[11px] font-bold uppercase tracking-wider mb-2">
          {{ product.type | default: "Haute Ready-to-Wear" }}
        </span>
        <h1 class="font-headline-lg text-3xl md:text-4xl font-bold text-primary tracking-tight">
          {{ product.title }}
        </h1>
        
        <div class="flex items-center gap-2 mt-2 text-amber-500 text-xs">
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="text-on-surface-variant font-medium">(128 Verified Reviews)</span>
        </div>
      </div>

      <!-- Price Box -->
      <div class="flex items-baseline gap-3 pb-4 border-b border-outline-variant/30">
        <span class="font-headline-sm text-3xl font-bold text-secondary">
          {{ current_variant.price | money }}
        </span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="text-base text-gray-400 line-through">
            {{ current_variant.compare_at_price | money }}
          </span>
        {%- endif -%}
      </div>

      <!-- Product Form -->
      {% form 'product', product, id: 'product-form', class: 'flex flex-col gap-6' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="selected-variant-id">

        <!-- Variant Options (if any) -->
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="flex flex-col gap-2">
              <label class="text-xs font-bold text-primary uppercase tracking-wider">
                Select {{ option.name }}:
              </label>
              <div class="flex flex-wrap gap-2">
                {%- for value in option.values -%}
                  <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold border border-outline-variant/40 hover:border-secondary transition-all {% if option.selected_value == value %}bg-primary text-white{% else %}bg-surface-container-low text-primary{% endif %}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <!-- Quantity Adjuster -->
        <div class="flex items-center gap-4">
          <label class="text-xs font-bold text-primary uppercase tracking-wider">Quantity:</label>
          <div class="flex items-center bg-surface-container-low rounded-xl border border-outline-variant/40 overflow-hidden">
            <button type="button" onclick="const q = document.getElementById('qty-input'); q.value = Math.max(1, parseInt(q.value) - 1);" class="w-10 h-10 flex items-center justify-center font-bold text-primary hover:bg-gray-200">-</button>
            <input type="number" name="quantity" id="qty-input" value="1" min="1" class="w-12 text-center bg-transparent font-bold text-sm text-primary focus:outline-none">
            <button type="button" onclick="const q = document.getElementById('qty-input'); q.value = parseInt(q.value) + 1;" class="w-10 h-10 flex items-center justify-center font-bold text-primary hover:bg-gray-200">+</button>
          </div>
        </div>

        <!-- Action CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-4">
          <button type="button" onclick="window.shopifyTheme.addToCart(document.getElementById('selected-variant-id').value, parseInt(document.getElementById('qty-input').value))" class="flex-1 py-4 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs uppercase tracking-wider shadow-lg flex items-center justify-center gap-2 hover:scale-[1.01] transition-all">
            <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
            <span>Add to Bag • {{ current_variant.price | money }}</span>
          </button>
          
          <button type="button" onclick="window.shopifyTheme.toggleWishlist('{{ product.handle }}')" class="p-4 rounded-full border border-outline-variant/40 hover:border-secondary text-primary hover:text-secondary transition-colors" title="Save to Wishlist">
            <span class="material-symbols-outlined text-[22px]">favorite</span>
          </button>
        </div>
      {% endform %}

      <!-- Craftsmanship Specifications Accordion -->
      <div class="pt-4 border-t border-outline-variant/30 space-y-3">
        <details class="group bg-surface-container-low rounded-2xl p-4 border border-outline-variant/30 cursor-pointer" open>
          <summary class="flex justify-between items-center font-bold text-xs text-primary uppercase tracking-wider list-none">
            <span>Description &amp; Story</span>
            <span class="material-symbols-outlined text-[18px] group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <p class="text-xs text-on-surface-variant mt-3 leading-relaxed">
            {{ product.description }}
          </p>
        </details>

        <details class="group bg-surface-container-low rounded-2xl p-4 border border-outline-variant/30 cursor-pointer">
          <summary class="flex justify-between items-center font-bold text-xs text-primary uppercase tracking-wider list-none">
            <span>Craftsmanship &amp; Care</span>
            <span class="material-symbols-outlined text-[18px] group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <div class="text-xs text-on-surface-variant mt-3 space-y-1">
            <p>• <strong>Composition:</strong> 80% Organic Combed Cotton, 20% European Flax Linen</p>
            <p>• <strong>Care:</strong> Machine wash cold on delicate cycle. Line dry in shade.</p>
            <p>• <strong>Fit:</strong> True to European sizing, relaxed A-line silhouette.</p>
          </div>
        </details>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
