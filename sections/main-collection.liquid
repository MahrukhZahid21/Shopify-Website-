<div class="flex flex-col w-full">
  <!-- Top Collection Header Banner -->
  <section class="relative overflow-hidden py-10 px-4 md:px-12 border-b-2 border-lavender/50 bg-gradient-chic">
    <div class="max-w-[1360px] mx-auto relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <nav class="flex items-center gap-2 text-xs font-medium text-on-surface-variant uppercase tracking-wider mb-2">
          <a class="hover:text-secondary transition-colors" href="{{ routes.root_url }}">Home</a>
          <span class="text-gray-400">/</span>
          <span class="text-secondary font-bold">{{ collection.title | default: 'All Collections' }}</span>
        </nav>
        <span class="inline-block text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full shadow-xs mb-2 bg-white text-primary border border-lavender">
          Curated Seasonal Edit
        </span>
        <h1 class="font-headline-lg text-3xl lg:text-5xl text-primary tracking-tight font-bold mt-1">
          {{ collection.title | default: 'Shop All' }} <span class="text-secondary italic">Collections</span>
        </h1>
        <p class="text-base text-on-surface-variant mt-2 leading-relaxed">
          {{ collection.description | default: 'Explore curated fashion pieces designed for effortless confidence, vibrant silhouettes, and luxury street appeal.' }}
        </p>
      </div>

      <!-- Quick Trending Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 self-start md:self-end">
        <span class="text-xs text-primary font-bold mr-1">Trending:</span>
        <a href="{{ routes.all_products_collection_url }}?cat=dresses" class="px-3.5 py-1.5 rounded-full bg-white text-primary hover:bg-[#d8b4f8] font-semibold text-xs transition-all shadow-xs border border-lavender">Summer Dresses</a>
        <a href="{{ routes.all_products_collection_url }}?cat=tops" class="px-3.5 py-1.5 rounded-full bg-[#d8b4f8] text-primary font-bold text-xs transition-all shadow-xs border border-purple-300">Pastel Tops ✨</a>
        <a href="{{ routes.all_products_collection_url }}?filter=sale" class="px-3.5 py-1.5 rounded-full bg-secondary text-white font-bold text-xs shadow-xs hover:bg-secondary-container transition-all">Hot Deals -40%</a>
      </div>
    </div>
  </section>

  <!-- Catalog Section (Sidebar + Grid) -->
  <section class="max-w-[1360px] mx-auto w-full px-4 md:px-12 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT SIDEBAR FILTER PANEL -->
      <aside class="lg:col-span-3 bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col gap-6 sticky top-[190px]">
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">tune</span>
            <h2 class="font-bold text-primary tracking-wide uppercase text-sm">Filters</h2>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold text-secondary hover:text-primary transition-colors underline underline-offset-4">
            Clear All
          </a>
        </div>

        <!-- Categories Navigation -->
        <div class="flex flex-col gap-2">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Categories</h3>
          <div class="flex flex-col space-y-1 text-xs">
            <a href="{{ routes.all_products_collection_url }}" class="flex items-center justify-between p-2 rounded-xl bg-purple-50 text-secondary font-bold border border-lavender transition-all">
              <span>All Products</span>
              <span class="bg-white px-2 py-0.5 rounded-full text-[10px] shadow-xs">{{ collection.all_products_count | default: 38 }}</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=women" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Women's Wear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=men" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Men's Wear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=accessories" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Accessories &amp; Jewelry</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=dresses" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Dresses &amp; Skirts</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=tops" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Tops &amp; Tees</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=denim" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Denim &amp; Jackets</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=shoes" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Shoes &amp; Footwear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=sunglasses" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Sunglasses</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=bags" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Bags &amp; Purses</span>
            </a>
          </div>
        </div>

        <!-- Size Filter -->
        <div class="flex flex-col gap-2 pt-2 border-t border-outline-variant/20">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Size</h3>
          <div class="grid grid-cols-3 gap-2">
            <button class="py-2 text-center rounded-xl text-xs font-bold bg-secondary text-white shadow-xs">ALL</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">XS</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">S</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">M</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">L</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">XL</button>
          </div>
        </div>

        <!-- Color Filter -->
        <div class="flex flex-col gap-2 pt-2 border-t border-outline-variant/20">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Color</h3>
          <div class="flex items-center flex-wrap gap-2.5">
            <span class="w-7 h-7 rounded-full bg-secondary shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-[#D8B4F8] shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-amber-100 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-sky-200 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-primary shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-white border border-gray-300 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
          </div>
        </div>

        <!-- App Coupon Promo Card -->
        <div class="mt-2 p-4 rounded-2xl bg-gradient-to-br from-primary-container to-secondary text-white flex flex-col gap-2 shadow-md">
          <span class="text-[10px] font-bold uppercase tracking-widest text-secondary-fixed">App Exclusive</span>
          <h4 class="text-base font-bold leading-tight">Get Extra 10% Off</h4>
          <p class="text-xs text-white/80">Use code <strong class="text-white underline">{{ settings.promo_code | default: "CHRONICAPP" }}</strong> at checkout.</p>
        </div>
      </aside>

      <!-- RIGHT PRODUCT CATALOG AREA -->
      <div class="lg:col-span-9 flex flex-col gap-6">
        <!-- Top Results Bar -->
        <div class="bg-surface-container-lowest rounded-2xl p-4 shadow-sm border border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-sm text-on-surface-variant font-medium">
            Showing <strong id="catalog-count-label" class="text-primary">{% if collection.products.size > 0 %}{{ collection.products.size }}{% else %}41{% endif %}</strong> items in <span id="catalog-title-label">{{ collection.title | default: 'All Collections' }}</span>
          </span>
          
          <div class="flex items-center gap-2">
            <label class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider" for="sort-by">Sort By:</label>
            <select id="sort-by" onchange="if(window.shopifyThemeCatalog) { window.shopifyThemeCatalog.applySort(this.value); } else { location.href = '?sort_by=' + this.value; }" class="bg-surface-container-low text-primary text-xs font-semibold px-3 py-2 rounded-xl border border-outline-variant/30 focus:outline-none focus:ring-2 focus:ring-secondary cursor-pointer">
              <option value="manual">Featured</option>
              <option value="price-ascending">Price: Low to High</option>
              <option value="price-descending">Price: High to Low</option>
              <option value="created-descending">Newest Arrivals</option>
            </select>
          </div>
        </div>

        {%- if collection.products.size == 0 -%}
          <!-- Notice for Store Preview / Initial Setup -->
          <div class="p-3.5 bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200/80 rounded-2xl text-xs text-primary flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-xs">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px] shrink-0">auto_awesome</span>
              <span><strong>Curated Catalog Active:</strong> Showing Chronics fashion collection. To import real products to your store database, import <code class="px-1.5 py-0.5 bg-white rounded border border-purple-300 font-mono text-[11px]">chronics-shopify-products.csv</code> in <strong>Shopify Admin &rarr; Products &rarr; Import</strong>.</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Product Grid -->
        {%- if collection.products.size > 0 -%}
          {%- paginate collection.products by section.settings.products_per_page -%}
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4" id="shopify-live-grid">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
            
            {%- if paginate.pages > 1 -%}
              <div class="flex justify-center items-center gap-2 mt-8">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-primary hover:bg-secondary hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                  </a>
                {%- endif -%}
                <span class="text-xs font-bold text-primary px-3">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-primary hover:bg-secondary hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        {%- else -%}
          <!-- Built-in Dynamic Fallback Grid (Never 0 Products) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4" id="products-catalog-grid">
            <div class="product-card group bg-surface-container-lowest rounded-2xl p-3 flex flex-col justify-between shadow-xs hover:shadow-xl border border-outline-variant/30 transition-all duration-300 relative">
              <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded-full bg-secondary text-white text-[10px] font-bold shadow-xs">-25%</span>
              <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center mb-3">
                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZ5v4FoFiApF3Qca4X2_9Nzy0hcZrbuM-jr2gzT1xr6PR7iJ2xIALMzTPus_WOYz5SQpLtiuTs0pexElPkwOPDWffpyhmLhI-cT4mUsmUe4ZSzg8JnMPXzDRPbHCrNw67MwF2_vIlyrc7SOf1VJf8xisbZL_H-s24qXXuE_QqqoQpp6w6FVngvAEi2YTu0rZJ6HMbXcjtyQZYFX_jJyAT9zypHF1lhR26JUTVqaZZuP0rEOfkdrxPlmA" alt="V-Neck Summer Dress">
              </div>
              <div class="flex flex-col flex-1 px-1 pb-1">
                {% render 'rating-stars', rating: 5.0, count: 128 %}
                <h4 class="text-sm font-semibold text-primary truncate">V-Neck Summer Dress</h4>
                <div class="flex items-center justify-between mt-2">
                  <span class="font-bold text-secondary text-base">$29.99</span>
                  <button onclick="window.shopifyTheme.showToast('Added to bag!', 'success')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-secondary hover:text-white text-primary flex items-center justify-center transition-all shadow-xs"><span class="material-symbols-outlined text-[18px]">shopping_bag</span></button>
                </div>
              </div>
            </div>

            <div class="product-card group bg-surface-container-lowest rounded-2xl p-3 flex flex-col justify-between shadow-xs hover:shadow-xl border border-outline-variant/30 transition-all duration-300 relative">
              <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded-full bg-secondary text-white text-[10px] font-bold shadow-xs">-28%</span>
              <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center mb-3">
                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGQVV-DXaD-x6TfGxrHsTD_-OgNicJtfTdn3AKKzXhiVSHJBSa9dbuawygqTBpN4Y7zD9s53j0JAgsx6tucejqAJ_pwW9GyyRpbL7zxHv_uugLNVG-O8rvlVOwe2dzyzrd1V3hsnaZ04PQbB8NMgKYCIroBttgPLlttxYJmhqlwA80rUByIKFiCBYoobvWu9YXl8GZy-rbg7VmVKysOi6_fvJl01XhnV2PZgsr0znMJXl2l6hEyj6ehw" alt="Vintage Baker Boy Cap">
              </div>
              <div class="flex flex-col flex-1 px-1 pb-1">
                {% render 'rating-stars', rating: 4.9, count: 115 %}
                <h4 class="text-sm font-semibold text-primary truncate">Vintage Baker Boy Cap</h4>
                <div class="flex items-center justify-between mt-2">
                  <span class="font-bold text-secondary text-base">$19.99</span>
                  <button onclick="window.shopifyTheme.showToast('Added to bag!', 'success')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-secondary hover:text-white text-primary flex items-center justify-center transition-all shadow-xs"><span class="material-symbols-outlined text-[18px]">shopping_bag</span></button>
                </div>
              </div>
            </div>

            <div class="product-card group bg-surface-container-lowest rounded-2xl p-3 flex flex-col justify-between shadow-xs hover:shadow-xl border border-outline-variant/30 transition-all duration-300 relative">
              <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center mb-3">
                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" alt="Layered Baroque Pearl & Gold Necklace">
              </div>
              <div class="flex flex-col flex-1 px-1 pb-1">
                {% render 'rating-stars', rating: 5.0, count: 88 %}
                <h4 class="text-sm font-semibold text-primary truncate">Layered Pearl Necklace</h4>
                <div class="flex items-center justify-between mt-2">
                  <span class="font-bold text-secondary text-base">$24.50</span>
                  <button onclick="window.shopifyTheme.showToast('Added to bag!', 'success')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-secondary hover:text-white text-primary flex items-center justify-center transition-all shadow-xs"><span class="material-symbols-outlined text-[18px]">shopping_bag</span></button>
                </div>
              </div>
            </div>

            <div class="product-card group bg-surface-container-lowest rounded-2xl p-3 flex flex-col justify-between shadow-xs hover:shadow-xl border border-outline-variant/30 transition-all duration-300 relative">
              <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded-full bg-secondary text-white text-[10px] font-bold shadow-xs">-30%</span>
              <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center mb-3">
                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDRldJOnG83Ggn7f8V9iNYbbnG2fWNzYa12MYAFpKtC2k289KsC0CdX8MXmdvnH-xfbbjGuVYVCiyKbEp6aF1WiwTM7t_FQuwANhJo_6XnTr6_C45FNfHFZ1OGkeqst4Sdrgk7ZT9rAwRgSl7dasVJm6KPzFce2iNUMbNDHEc--LfuQLNKvSZz05WGzsXyzuWH64TOQ7MyNBtyyDjYjRMOlx6jJBPdshIrAB3EUU-JEG4ffQiTFw47zRA" alt="Striped Casual Shirt">
              </div>
              <div class="flex flex-col flex-1 px-1 pb-1">
                {% render 'rating-stars', rating: 4.9, count: 150 %}
                <h4 class="text-sm font-semibold text-primary truncate">Striped Casual Shirt</h4>
                <div class="flex items-center justify-between mt-2">
                  <span class="font-bold text-secondary text-base">$27.99</span>
                  <button onclick="window.shopifyTheme.showToast('Added to bag!', 'success')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-secondary hover:text-white text-primary flex items-center justify-center transition-all shadow-xs"><span class="material-symbols-outlined text-[18px]">shopping_bag</span></button>
                </div>
              </div>
            </div>
          </div>

          <script>
            // Automatic Dynamic Theme Catalog for Empty Store / Preview Mode
            window.shopifyThemeCatalog = {
              activeCategory: 'all',
              currentSort: 'manual',
              init() {
                const params = new URLSearchParams(window.location.search);
                const catParam = params.get('cat');
                if (catParam) {
                  this.activeCategory = catParam;
                }
                this.render();
              },
              applySort(val) {
                this.currentSort = val;
                this.render();
              },
              render() {
                if (typeof PRODUCTS_DATA === 'undefined') return;
                const grid = document.getElementById('products-catalog-grid');
                const countLabel = document.getElementById('catalog-count-label');
                const titleLabel = document.getElementById('catalog-title-label');
                if (!grid) return;

                let list = PRODUCTS_DATA.filter(p => {
                  if (this.activeCategory === 'all') return true;
                  if (this.activeCategory === 'women') return p.gender === 'women';
                  if (this.activeCategory === 'men') return p.gender === 'men';
                  if (this.activeCategory === 'accessories') {
                    return p.category === 'accessories' || p.tags?.includes('Accessories') || p.tags?.includes('Jewelry') || p.tags?.includes('Caps') || p.tags?.includes('Headwear') || p.tags?.includes('Belts');
                  }
                  return p.category === this.activeCategory;
                });

                if (this.currentSort === 'price-ascending') list.sort((a, b) => a.price - b.price);
                else if (this.currentSort === 'price-descending') list.sort((a, b) => b.price - a.price);

                if (countLabel) countLabel.textContent = list.length;
                if (titleLabel) titleLabel.textContent = this.activeCategory.charAt(0).toUpperCase() + this.activeCategory.slice(1);

                grid.innerHTML = list.map(p => `
                  <div class="product-card group bg-surface-container-lowest rounded-2xl p-3 flex flex-col justify-between shadow-xs hover:shadow-xl border border-outline-variant/30 transition-all duration-300 relative">
                    ${p.discount ? `<span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded-full bg-secondary text-white text-[10px] font-bold shadow-xs">${p.discount}</span>` : ''}
                    <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center mb-3">
                      <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="${p.images[0]}" alt="${p.title}">
                    </div>
                    <div class="flex flex-col flex-1 px-1 pb-1">
                      <div class="flex items-center gap-1 text-amber-500 mb-1 text-xs">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="font-bold text-xs">${p.rating}</span>
                        <span class="text-on-surface-variant/80 ml-1 text-[11px]">(${p.reviewsCount})</span>
                      </div>
                      <h4 class="text-sm font-semibold text-primary truncate">${p.title}</h4>
                      <div class="flex items-center justify-between mt-2">
                        <div class="flex items-baseline gap-1.5">
                          <span class="font-bold text-secondary text-base">$${p.price.toFixed(2)}</span>
                          ${p.originalPrice ? `<span class="text-xs text-outline line-through">$${p.originalPrice.toFixed(2)}</span>` : ''}
                        </div>
                        <button onclick="window.shopifyTheme.showToast('Added ' + ${JSON.stringify(p.title)} + ' to bag!', 'success')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-secondary hover:text-white text-primary flex items-center justify-center transition-all shadow-xs" title="Add to Bag">
                          <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                        </button>
                      </div>
                    </div>
                  </div>
                `).join('');
              }
            };
            document.addEventListener('DOMContentLoaded', () => {
              window.shopifyThemeCatalog.init();
            });
          </script>
        {%- endif -%}

      </div>

    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
