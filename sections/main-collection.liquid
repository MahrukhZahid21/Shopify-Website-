<div class="flex flex-col w-full">
  <!-- Top Collection Header Banner -->
  <section class="relative overflow-hidden py-10 px-4 md:px-12 border-b-2 border-lavender/50 bg-gradient-chic">
    <div class="max-w-[1360px] mx-auto relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <nav class="flex items-center gap-2 text-xs font-medium text-on-surface-variant uppercase tracking-wider mb-2">
          <a class="hover:text-secondary transition-colors" href="{{ routes.root_url }}">Home</a>
          <span class="text-gray-400">/</span>
          <span class="text-secondary font-bold">{{ collection.title | default: 'All Collections' }}</span>
        </nav>
        <span class="inline-block text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full shadow-xs mb-2 bg-white text-primary border border-lavender">
          Curated Seasonal Edit
        </span>
        <h1 class="font-headline-lg text-3xl lg:text-5xl text-primary tracking-tight font-bold mt-1">
          {{ collection.title | default: 'Shop All' }} <span class="text-secondary italic">Collections</span>
        </h1>
        <p class="text-base text-on-surface-variant mt-2 leading-relaxed">
          {{ collection.description | default: 'Explore curated fashion pieces designed for effortless confidence, vibrant silhouettes, and luxury street appeal.' }}
        </p>
      </div>

      <!-- Quick Trending Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 self-start md:self-end">
        <span class="text-xs text-primary font-bold mr-1">Trending:</span>
        <a href="{{ routes.all_products_collection_url }}?cat=dresses" class="px-3.5 py-1.5 rounded-full bg-white text-primary hover:bg-[#d8b4f8] font-semibold text-xs transition-all shadow-xs border border-lavender">Summer Dresses</a>
        <a href="{{ routes.all_products_collection_url }}?cat=tops" class="px-3.5 py-1.5 rounded-full bg-[#d8b4f8] text-primary font-bold text-xs transition-all shadow-xs border border-purple-300">Pastel Tops ✨</a>
        <a href="{{ routes.all_products_collection_url }}?filter=sale" class="px-3.5 py-1.5 rounded-full bg-secondary text-white font-bold text-xs shadow-xs hover:bg-secondary-container transition-all">Hot Deals -40%</a>
      </div>
    </div>
  </section>

  <!-- Catalog Section (Sidebar + Grid) -->
  <section class="max-w-[1360px] mx-auto w-full px-4 md:px-12 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT SIDEBAR FILTER PANEL -->
      <aside class="lg:col-span-3 bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col gap-6 sticky top-[190px]">
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">tune</span>
            <h2 class="font-bold text-primary tracking-wide uppercase text-sm">Filters</h2>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold text-secondary hover:text-primary transition-colors underline underline-offset-4">
            Clear All
          </a>
        </div>

        <!-- Categories Navigation -->
        <div class="flex flex-col gap-2">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Categories</h3>
          <div class="flex flex-col space-y-1 text-xs">
            <a href="{{ routes.all_products_collection_url }}" class="flex items-center justify-between p-2 rounded-xl bg-purple-50 text-secondary font-bold border border-lavender transition-all">
              <span>All Products</span>
              <span class="bg-white px-2 py-0.5 rounded-full text-[10px] shadow-xs">{{ collection.all_products_count | default: 38 }}</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=women" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Women's Wear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=men" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Men's Wear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=accessories" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Accessories &amp; Jewelry</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=dresses" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Dresses &amp; Skirts</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=tops" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Tops &amp; Tees</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=denim" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Denim &amp; Jackets</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=shoes" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Shoes &amp; Footwear</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=sunglasses" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Sunglasses</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?cat=bags" class="flex items-center justify-between p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-all">
              <span>Bags &amp; Purses</span>
            </a>
          </div>
        </div>

        <!-- Size Filter -->
        <div class="flex flex-col gap-2 pt-2 border-t border-outline-variant/20">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Size</h3>
          <div class="grid grid-cols-3 gap-2">
            <button class="py-2 text-center rounded-xl text-xs font-bold bg-secondary text-white shadow-xs">ALL</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">XS</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">S</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">M</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">L</button>
            <button class="py-2 text-center rounded-xl text-xs font-semibold bg-surface-container-low text-on-surface hover:bg-surface-container-high">XL</button>
          </div>
        </div>

        <!-- Color Filter -->
        <div class="flex flex-col gap-2 pt-2 border-t border-outline-variant/20">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Color</h3>
          <div class="flex items-center flex-wrap gap-2.5">
            <span class="w-7 h-7 rounded-full bg-secondary shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-[#D8B4F8] shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-amber-100 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-sky-200 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-primary shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
            <span class="w-7 h-7 rounded-full bg-white border border-gray-300 shadow-xs cursor-pointer hover:scale-110 transition-transform"></span>
          </div>
        </div>

        <!-- App Coupon Promo Card -->
        <div class="mt-2 p-4 rounded-2xl bg-gradient-to-br from-primary-container to-secondary text-white flex flex-col gap-2 shadow-md">
          <span class="text-[10px] font-bold uppercase tracking-widest text-secondary-fixed">App Exclusive</span>
          <h4 class="text-base font-bold leading-tight">Get Extra 10% Off</h4>
          <p class="text-xs text-white/80">Use code <strong class="text-white underline">{{ settings.promo_code | default: "CHRONICAPP" }}</strong> at checkout.</p>
        </div>
      </aside>

      <!-- RIGHT PRODUCT CATALOG AREA -->
      <div class="lg:col-span-9 flex flex-col gap-6">
        <!-- Top Results Bar -->
        <div class="bg-surface-container-lowest rounded-2xl p-4 shadow-sm border border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-sm text-on-surface-variant font-medium">
            Showing <strong class="text-primary">{{ collection.products.size }}</strong> items in {{ collection.title }}
          </span>
          
          <div class="flex items-center gap-2">
            <label class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider" for="sort-by">Sort By:</label>
            <select id="sort-by" onchange="location.href = '?sort_by=' + this.value" class="bg-surface-container-low text-primary text-xs font-semibold px-3 py-2 rounded-xl border border-outline-variant/30 focus:outline-none focus:ring-2 focus:ring-secondary cursor-pointer">
              <option value="manual">Featured</option>
              <option value="price-ascending">Price: Low to High</option>
              <option value="price-descending">Price: High to Low</option>
              <option value="created-descending">Newest Arrivals</option>
            </select>
          </div>
        </div>

        <!-- Product Grid -->
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
            
            {%- if paginate.pages > 1 -%}
              <div class="flex justify-center items-center gap-2 mt-8">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-primary hover:bg-secondary hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                  </a>
                {%- endif -%}
                <span class="text-xs font-bold text-primary px-3">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-primary hover:bg-secondary hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="py-16 text-center text-on-surface-variant">
              <span class="material-symbols-outlined text-5xl text-lavender block mb-2">sentiment_dissatisfied</span>
              <h3 class="font-bold text-primary text-base">{{ 'sections.collection_template.empty' | t }}</h3>
              <p class="text-xs text-on-surface-variant mt-1">Check back soon for new runway arrivals.</p>
            </div>
          {%- endif -%}
        {%- endpaginate -%}

      </div>

    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
