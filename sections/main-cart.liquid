<div class="max-w-[1200px] mx-auto w-full px-4 md:px-12 py-12">
  <div class="flex items-center justify-between pb-6 border-b border-outline-variant/30 mb-8">
    <h1 class="font-headline-lg text-3xl md:text-4xl font-bold text-primary">Your Shopping Bag</h1>
    <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold text-secondary hover:text-primary transition-colors flex items-center gap-1">
      <span class="material-symbols-outlined text-[16px]">arrow_back</span>
      <span>Continue Shopping</span>
    </a>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Cart Items Table -->
      <div class="lg:col-span-8 bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 shadow-xs space-y-6">
        {% for item in cart.items %}
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 {% unless forloop.last %}border-b border-outline-variant/20{% endunless %}">
            <div class="flex items-center gap-4 w-full sm:w-auto">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-20 h-24 object-cover rounded-2xl bg-surface-container-low shrink-0 border border-outline-variant/30">
              {% endif %}
              <div class="flex-1 min-w-0">
                <a href="{{ item.url }}" class="font-bold text-sm text-primary hover:text-secondary transition-colors block truncate">
                  {{ item.product.title }}
                </a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-xs text-on-surface-variant mt-0.5">{{ item.variant.title }}</p>
                {% endunless %}
                <span class="text-xs font-bold text-secondary mt-1 block">{{ item.price | money }}</span>
              </div>
            </div>

            <div class="flex items-center justify-between w-full sm:w-auto gap-6">
              <!-- Quantity -->
              <div class="flex items-center bg-surface-container-low rounded-xl border border-outline-variant/40 overflow-hidden">
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="w-8 h-8 flex items-center justify-center font-bold text-primary hover:bg-gray-200 transition-colors">-</a>
                <span class="w-8 text-center text-xs font-bold text-primary">{{ item.quantity }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="w-8 h-8 flex items-center justify-center font-bold text-primary hover:bg-gray-200 transition-colors">+</a>
              </div>

              <!-- Total & Remove -->
              <div class="text-right min-w-[80px]">
                <span class="font-bold text-sm text-primary block">{{ item.final_line_price | money }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-[11px] text-red-600 hover:underline mt-0.5 inline-block">
                  Remove
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Order Summary Card -->
      <div class="lg:col-span-4 bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 shadow-md flex flex-col gap-4 sticky top-[190px]">
        <h3 class="font-bold text-base text-primary uppercase tracking-wider pb-3 border-b border-outline-variant/20">Order Summary</h3>
        
        <div class="flex justify-between items-center text-xs text-on-surface-variant">
          <span>Subtotal</span>
          <span class="font-bold text-primary text-sm">{{ cart.total_price | money }}</span>
        </div>
        
        <div class="flex justify-between items-center text-xs text-on-surface-variant">
          <span>Estimated Shipping</span>
          <span class="font-bold text-emerald-600">Calculated at checkout</span>
        </div>

        <div class="flex justify-between items-center text-sm font-bold text-primary pt-3 border-t border-outline-variant/30">
          <span>Total</span>
          <span class="text-secondary text-xl font-bold">{{ cart.total_price | money }}</span>
        </div>

        <button type="submit" name="checkout" class="w-full py-4 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs uppercase tracking-wider shadow-lg flex items-center justify-center gap-2 hover:scale-[1.01] transition-all mt-2">
          <span>Proceed to Checkout</span>
          <span class="material-symbols-outlined text-[18px]">lock</span>
        </button>

        <p class="text-[11px] text-center text-on-surface-variant mt-1">
          Complimentary 30-Day Returns • 100% Authentic Luxury Guarantee
        </p>
      </div>
    </form>
  {% else %}
    <div class="py-20 text-center bg-surface-container-lowest rounded-3xl border border-outline-variant/30 p-8">
      <span class="material-symbols-outlined text-6xl text-lavender block mb-3">shopping_bag</span>
      <h2 class="font-headline-sm text-2xl font-bold text-primary">Your Bag is Empty</h2>
      <p class="text-xs text-on-surface-variant mt-2 max-w-sm mx-auto">Discover our runway-ready seasonal edits and timeless wardrobe staples.</p>
      <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 mt-6 px-8 py-3.5 rounded-full bg-secondary hover:bg-secondary-container text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all">
        <span>Explore All Collections</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
